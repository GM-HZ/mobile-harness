+int llama_server_mobile(common_params & params, const std::atomic<bool> & stop, std::atomic<bool> & ready);
+int llama_server_mobile(common_params & params, const std::atomic<bool> & stop, std::atomic<bool> & ready) {
+    server_run_opts opts;
+    opts.install_signal_handlers = false;
+    opts.resolve_model = false;
+    opts.stop = &stop;
+    opts.ready = &ready;
+
+    common_init();
+    common_log_pause(common_log_main());
+    llama_backend_init();
+    llama_numa_init(params.numa);
+    server_stream_session_manager_start();
+    server_role role;
+    const int result = server_run(params, 0, nullptr, role, opts);
+    server_stream_session_manager_stop();
+    llama_backend_free();
+    return result;
+}
