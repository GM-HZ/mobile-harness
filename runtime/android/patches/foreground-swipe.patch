+        if (cancelled(gen)) throw InterruptedException()
         val before = clock.count
+        if (swipe != null && end != null) {
+            // l10n:keep agent screen result
+            if (!actuator.swipe(point.first, point.second, end.first, end.second)) return ActionResult(false, "系统没有接受这次滑动。", observeQuiet())
+            // l10n:keep agent screen result
+            return after(before, snap, gen, "已提交从 ($x, $y) 到 (${swipe.endX}, ${swipe.endY}) 的滑动。")
+        }
