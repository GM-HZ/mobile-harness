+                if (ScreenShooter.sensitiveBounds(cap.windows).any { !it.intersect(pathBounds).isEmpty }) {
+                    // l10n:keep agent screen result
+                    return ActionResult(false, "这次滑动可能经过敏感内容，请 handoff。")
+                }
+            }
