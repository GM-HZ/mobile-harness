+  /// Start new chats on the just-configured route when the bundled default has no credential.
+  Future<bool> _setUpDefaultModel(String provider) async {
+    final connection = ref.read(activeConnectionProvider).value;
+    if (connection == null || !connection.isLocal) return false;
+    final client = connection.client;
+    final scope = ref.read(modelSelectionScopeProvider);
+    bool current() => mounted && identical(ref.read(modelSelectionScopeProvider), scope);
+
+    final section = await client.settingsSection(defaultModelSettingsNs);
+    if (!current() || section == null) return false;
+    final catalog = await client.listModels();
+    if (!current()) return false;
+    if (isValidModelSelection(catalog, ModelSelection.fromJson(section.value))) return true;
+    final model = catalog.models.where((model) => model.provider == provider).firstOrNull;
+    if (!section.writable || model == null) return false;
+
+    final selection = ModelSelection(provider: provider, model: model.id, reasoningEffort: startingEffort(model));
+    final saved = await client.mutateSettings(
+      defaultModelSettingsNs,
+      defaultModelOps(selection),
+      expectedRevision: section.revision,
+    );
+    if (!current()) return false;
+    ref.invalidate(modelCatalogProvider);
+    return jsonEquals(ModelSelection.fromJson(saved.value)?.toJson(), selection.toJson());
