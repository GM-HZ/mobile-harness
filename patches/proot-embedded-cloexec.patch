+/* A real exec closes these descriptors in the kernel. The preloaded
+ * Harmony loader replaces the image without a kernel exec. */
+static int embedded_cloexec_fds(Tracee *tracee, int **fds, size_t *count)
+{
+	char path[64];
+	snprintf(path, sizeof(path), "/proc/%d/fdinfo", tracee->pid);
+	DIR *directory = opendir(path);
+	if (!directory)
+		return -errno;
+
+	size_t capacity = 0;
+	int status = 0;
+	for (;;) {
+		errno = 0;
+		struct dirent *entry = readdir(directory);
+		if (!entry) {
+			status = -errno;
+			break;
+		}
+		char *end;
+		long fd = strtol(entry->d_name, &end, 10);
+		if (*entry->d_name < '0' || *entry->d_name > '9' || *end || fd < 0 || fd > INT_MAX)
+			continue;
+		int info = openat(dirfd(directory), entry->d_name, O_RDONLY | O_CLOEXEC);
+		if (info < 0) {
+			if (errno == ENOENT)
+				continue;
+			status = -errno;
+			break;
+		}
+		char buffer[256];
+		ssize_t length;
+		do {
+			length = read(info, buffer, sizeof(buffer) - 1);
+		} while (length < 0 && errno == EINTR);
+		int read_error = errno;
+		close(info);
+		if (length < 0) {
+			status = -read_error;
+			break;
+		}
+		buffer[length] = '\0';
+		const char *flags = strstr(buffer, "\nflags:");
+		if (!flags) {
+			status = -EIO;
+			break;
+		}
+		if (!(strtoul(flags + sizeof("\nflags:") - 1, NULL, 8) & O_CLOEXEC))
+			continue;
+		if (*count == capacity) {
+			capacity = capacity ? capacity * 2 : 16;
+			int *grown = talloc_realloc(tracee->ctx, *fds, int, capacity);
+			if (!grown) {
+				status = -ENOMEM;
+				break;
+			}
+			*fds = grown;
+		}
+		(*fds)[(*count)++] = (int) fd;
+	}
+	closedir(directory);
+	return status;
+}
