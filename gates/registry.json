{
  "schema": 1,
  "source": "scripts/adaptation/registry.py",
  "tiers": {
    "G0": {
      "name": "static/consistency",
      "entries": [
        {
          "id": "adaptation-verify",
          "command": "python3 scripts/adaptation/verify.py",
          "covers": "manifest/pins/submodule consistency",
          "timeout": 120
        },
        {
          "id": "manifest-fresh",
          "command": "python3 scripts/adaptation/inventory.py --check",
          "covers": "checked-in manifest matches the tree",
          "timeout": 120
        },
        {
          "id": "relay-preflight-self-test",
          "command": "python3 tests/smoke/relay-preflight.py --self-test",
          "covers": "public Relay preflight tooling",
          "requires": [
            "pinned DSH runtime cache"
          ],
          "optional": true,
          "timeout": 180
        }
      ]
    },
    "G1": {
      "name": "host contracts",
      "entries": [
        {
          "id": "host-syntax",
          "command": "python3 scripts/adaptation/host_checks.py",
          "covers": "node --check for host/compat overlays",
          "timeout": 180
        },
        {
          "id": "upstream-anchors",
          "command": "python3 scripts/adaptation/anchors.py",
          "covers": "literal upstream anchors used by runtime hooks",
          "requires": [
            "assembled DSH layer in the current worktree"
          ],
          "timeout": 300
        },
        {
          "id": "compat-inventory",
          "command": "python3 scripts/adaptation/compat_check.py",
          "covers": "compat modules have inventory rows, consumers and documented gates",
          "timeout": 120
        },
        {
          "id": "compat-contracts",
          "command": "python3 scripts/adaptation/compat_contracts.py",
          "covers": "forge/package/liveshare/sharp public behavior contracts",
          "timeout": 120
        },
        {
          "id": "guidance-docs",
          "command": "python3 scripts/adaptation/guidance_check.py",
          "covers": "AGENTS/framework/roadmap/module guidance files, sections and indexes",
          "timeout": 120
        },
        {
          "id": "remote-hosts-contract",
          "command": "node tests/contract/remote-hosts.cjs",
          "covers": "self/lab gate, HTTPS origin, same-origin token exchange and metadata-only persistence",
          "timeout": 120
        },
        {
          "id": "local-inference-settings",
          "command": "node tests/contract/local-inference-route.cjs",
          "covers": "authenticated loopback provider updates, model switching, and reversible local default",
          "timeout": 120
        },
        {
          "id": "local-llm-agent-probe",
          "command": "test -n \"$MH_LOCAL_LLM_MODEL\" || exit 2; python3 tests/smoke/local-llm-agent-probe.py --model \"$MH_LOCAL_LLM_MODEL\" --base-url \"${MH_LOCAL_LLM_BASE_URL:-http://127.0.0.1:8080/v1}\" --backend \"${MH_LOCAL_LLM_BACKEND:-llama.cpp}\"",
          "covers": "local Chat Completions SSE tool calls, result continuation and no-tool control",
          "requires": [
            "MH_LOCAL_LLM_MODEL env",
            "running loopback model server"
          ],
          "optional": true,
          "timeout": 200
        },
        {
          "id": "workflow-check",
          "command": "python3 scripts/adaptation/workflow_check.py",
          "covers": "gate workflows stay wired to gate scripts and steps",
          "timeout": 120
        },
        {
          "id": "anchor-coverage",
          "command": "python3 scripts/adaptation/anchor_scan.py --check",
          "covers": "every replacePinned anchor is indexed in adaptation/anchors.full.json",
          "timeout": 120
        },
        {
          "id": "host-regressions",
          "command": "python3 scripts/adaptation/host_regressions.py",
          "covers": "/bin/bash routing, padded status parsing, probe done/ok checks",
          "timeout": 120
        },
        {
          "id": "forge-account-fixture",
          "command": "python3 tests/smoke/emulator-forge-account.py \"$MH_EMULATOR\" .build/gate-evidence/forge-account.json",
          "covers": "Forge account device-flow fixture (clean app data required)",
          "requires": [
            "MH_EMULATOR env",
            "bm clean -n org.sayact.nodepoc -d before the run"
          ],
          "optional": true,
          "timeout": 1800
        },
        {
          "id": "patch-targets",
          "command": "python3 scripts/adaptation/patch_targets.py --check",
          "covers": "machine patch index matches series.json/anchors and TARGETS.md",
          "timeout": 120
        },
        {
          "id": "patch-rehearsal",
          "command": "python3 scripts/adaptation/patch_rehearsal.py",
          "covers": "patches/series.json applies cleanly to the pinned tarballs",
          "requires": [
            "upstream tarball cache (scripts/adaptation/bump.py)"
          ],
          "optional": true,
          "timeout": 300
        },
        {
          "id": "host-contracts",
          "command": "python3 scripts/adaptation/host_contracts.py",
          "covers": "apply boot-time transformations and validate the results",
          "requires": [
            "assembled DSH layer"
          ],
          "optional": true,
          "timeout": 300
        },
        {
          "id": "upstream-bump-rehearsal",
          "command": "python3 scripts/adaptation/bump.py",
          "covers": "dry-run the next DSH release against our anchors",
          "requires": [
            "npm registry"
          ],
          "optional": true,
          "timeout": 600
        }
      ],
      "note": "anchor checks need the assembled DSH layer (build machine)"
    },
