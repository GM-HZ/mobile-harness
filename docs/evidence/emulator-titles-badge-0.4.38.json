    "source": "import hashlib\nimport json\nfrom pathlib import Path\nimport runpy\n\nscript = runpy.run_path('tests/smoke/emulator-titles-badge.py')\nsupport = script['support']\nagent = script['agent']\nroot = Path('.build/titles-badge')\ne = support['Emulator']('127.0.0.1:15557', 19644)\nforward = ('tcp:19644', 'tcp:19592')\ne.hdc('fport', *forward)\ntry:\n    e.ready('normal')\n    audit = {'boot':e.state(), 'anonymousHttp':e.web_status(False), 'authenticatedHttp':e.web_status(True),\n             'defaultPermissionPreset':e.rpc('permissionPresets/catalog',{})['defaultPreset'],\n             'testCredentialAbsent':not e.rpc('credentials/describe',{'refs':['DEEPSEEK_API_KEY']})['DEEPSEEK_API_KEY']['configured']}\n    assert audit['boot'] == {'mode':'normal','pending':False}\n    assert (audit['anonymousHttp'],audit['authenticatedHttp']) == (401,200)\n    assert audit['defaultPermissionPreset'] == 'workspace-write' and audit['testCredentialAbsent']\n    assert e.app('test ! -e ' + 'alpine/native-benchmark-home/cordis.patch.yml' + ' && printf ABSENT') == 'ABSENT'\n    audit['homePatchAbsent'] = True\n    profile = script['PROFILE']\n    digests = {name:hashlib.sha256(agent['read_bytes'](e,profile+'/'+name)).hexdigest() for name in ['package.json','pnpm-lock.yaml']}\n    assert digests == {'package.json':'c5955d33c12dce37f48bbd9f6319bbb6288b19ab49af22898aa337403b4608b8',\n                       'pnpm-lock.yaml':'3e17f9c545e2c97679668286cedc0e0907159ee38a2b457569802b8a320b913e'}\n    audit['profileHashes'] = digests\n    audit['catalogRestoredToDisabled'] = script['catalog'](e,False)\n    script['assert_providers'](e, False)\n    audit['defaultTitleProviderRestored'] = True\n    prior_catalog = runpy.run_path('tests/smoke/emulator-worktree-restore.py')\n    audit['priorFourOptionalBundlesStillOfferedAndDisabled'] = prior_catalog['catalog_state'](e, set())\n    rows = support['events'](e,'session-ecf0df3c-47a9-4df4-b71e-6d4261d13419')\n    assert len(rows)==30\n    audit['oldRc3SessionEventCount'] = len(rows)\n    recorded = json.loads((root/'artifact.json').read_text())\n    release = 'alpine/.dsh-0.2.2-rc.4'\n    manifest = json.loads(agent['read_bytes'](e,release+'/dsh/package.json'))\n    assert recorded['newCarrierDependencies'].items() <= manifest['dependencies'].items()\n    assert e.app('test -f '+release+'/.validated-unpack-v2-dsh-layer.zip-'+recorded['layerSha256']+' && printf PRESENT') == 'PRESENT'\n    audit['installedDshLayerSha256'] = recorded['layerSha256']\n    (root/'audit.json').write_text(json.dumps(audit,indent=2)+'\\n')\n    print(json.dumps(audit))\nfinally:\n    e.hdc('fport','rm',*forward)\n",
