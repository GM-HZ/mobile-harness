og['catalog_state'](e, set())\n    rows = support['events'](e,'session-ecf0df3c-47a9-4df4-b71e-6d4261d13419')\n    assert len(rows)==30\n    audit['oldRc3SessionEventCount'] = len(rows)\n    fixture = json.loads((root/'chat-import-0.4.39.json').read_text())\n    assert e.app('test ! -e alpine/workspace-native/'+fixture['fixture']+' && printf ABSENT') == 'ABSENT'\n    audit['fixtureDirectoryAbsent'] = True\n    sessions = fixture['uploadLines'][-1]['outcome']['value']['sessionIds']\n    picture_events = support['events'](e, sessions[1])\n    imported_picture = fixture['importedTrace']['picture']\n    assert picture_events[:len(imported_picture)] == imported_picture\n    content = next(row['data']['content'] for row in picture_events if row['type'] == 'user/message')\n    reference = next(item['attachment'] for item in content if item['type'] == 'image')\n    stored = e.rpc('session/attachment', {'request':{'sessionId':sessions[1], 'attachment':reference}})\n    audit['archivedPngSha256AfterRestart'] = hashlib.sha256(base64.b64decode(stored['data'], validate=True)).hexdigest()\n    assert audit['archivedPngSha256AfterRestart'] == fixture['retrievedPngSha256']\n    recorded = json.loads((root/'artifact.json').read_text())\n    release = 'alpine/.dsh-0.2.2-rc.4'\n    manifest = json.loads(agent['read_bytes'](e,release+'/dsh/package.json'))\n    assert recorded['newCarrierDependencies'].items() <= manifest['dependencies'].items()\n    assert e.app('test -f '+release+'/.validated-unpack-v2-dsh-layer.zip-'+recorded['layerSha256']+' && printf PRESENT') == 'PRESENT'\n    audit['installedDshLayerSha256'] = recorded['layerSha256']\n    (root/'audit.json').write_text(json.dumps(audit,indent=2)+'\\n')\n    print(json.dumps(audit))\nfinally:\n    e.hdc('fport','rm',*forward)\n",
