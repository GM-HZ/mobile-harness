    "source": "import assert from 'node:assert/strict';\nimport { createRequire } from 'node:module';\nimport path from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst modules = path.resolve(process.argv[2]);\nconst resolve = createRequire(path.join(modules, '../package.json'));\nconst { Context } = await import(pathToFileURL(resolve.resolve('@deepseek-ai/cordis')).href);\nconst { default: WebRuntime } = await import(pathToFileURL(resolve.resolve('@deepseek-ai/dsh-web')).href);\nconst setup = async config => {\n  const ctx = new Context();\n  const fiber = await ctx.plugin(WebRuntime, config);\n  const available = new Map([['deepseek-official',true],['deepseek-search-api',true]]);\n  const readyCalls = [];\n  for (const id of available.keys()) {\n    ctx.web.registerSearchProvider({\n      id,\n      available: () => available.get(id),\n      async search() { return {content:id,sources:[],truncated:false}; },\n      async ready(route) { readyCalls.push({id,route}); return true; },\n    });\n  }\n  return { web:ctx.web,fiber,available,readyCalls };\n};\nconst automatic = await setup({});\nconst checks = [];\ntry {\n  for (const [route, expected] of [\n    ['deepseek-official','deepseek-official'],\n    ['deepseek-account','deepseek-official'],\n    ['openai','deepseek-search-api'],\n    [undefined,'deepseek-search-api'],\n  ]) {\n    assert(await automatic.web.searchReady(route));\n    assert.deepEqual(automatic.readyCalls.at(-1), {id:expected,route});\n    const result = await automatic.web.search({query:'fixture',llmProvider:route});\n    assert.equal(result.content,expected);\n    checks.push({route:route ?? null,provider:expected});\n  }\n  automatic.available.set('deepseek-official',false);\n  assert.equal((await automatic.web.search({query:'fixture',llmProvider:'deepseek-official'})).content,'deepseek-search-api');\n  checks.push({unavailablePreferred:'deepseek-official',fallback:'deepseek-search-api'});\n} finally {\n  await automatic.fiber.dispose();\n}\nconst pinned = await setup({searchProvider:'deepseek-search-api'});\ntry {\n  const result = await pinned.web.search({query:'fixture',llmProvider:'deepseek-official'});\n  assert.equal(result.content,'deepseek-search-api');\n  checks.push({configured:'deepseek-search-api',provider:result.content});\n} finally {\n  await pinned.fiber.dispose();\n}\nconsole.log(JSON.stringify(checks,null,2));\n",
