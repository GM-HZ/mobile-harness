  "ptcHardLinkReadHardening": {
    "change": "grant_path and stat_path now require st_nlink == 1 for regular files unless the launch grants the namespace root",
    "previousBehaviour": "reads and stats of a multi-link regular file inside a granted root were allowed; writes and truncation already refused st_nlink != 1",
    "symbolicLinks": "every resolution uses a pre-opened root descriptor with RESOLVE_NO_SYMLINKS, so a link cannot redirect a granted path outside the root",
    "concurrentParentMoves": "each request resolves again from the root descriptor; there is no path-to-descriptor cache, so a moved parent degrades to ENOENT/ELOOP instead of escaping",
