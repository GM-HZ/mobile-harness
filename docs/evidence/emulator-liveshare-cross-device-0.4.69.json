  "scope": {
    "verified": [
      "the owner completes the LiveShare share dialog inside ArkWeb against the fixture Relay and the PKCE exchange matches",
      "the second device's real Huawei browser loads the official viewer page and renders the shared session with its renamed title, history messages and timestamps",
      "the viewer page reads /__liveshare/context and 10 page assets through cookie-authorized Relay requests; viewer RPCs return 200",
      "the viewer shows the read-only notice and the locked model, and never calls the owner management endpoint",
      "the owner-side reader regression still refuses unshared sessions and owner management, applies live revocation and stops the share",
      "the first device profile and boot configuration are restored after the run"
    ],
    "pending": [
      "the official LiveShare Relay service, which is not delivered by the upstream package or this repository",
      "a real identity provider and OAuth/OIDC session exchange",
      "public-network cross-device operation and public CA TLS/WSS",
      "physical device (Mate 60) viewer and owner regression"
    ],
    "titleNote": "without the owner-login scenario the shared sessions have no archive history and session/list carries no titles (the profile does not enable the optional session-titles bundle); the owner-login scenario imports an archived session and its title and messages render on the viewer page",
    "notClaimed": "cross-device between two local emulators over the host loopback port forward, not public deployment"
  }
}
